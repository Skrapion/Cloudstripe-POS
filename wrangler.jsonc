{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cloudstripe-pos",
	"main": "src/index.js",
	"compatibility_date": "2026-11-10",
	"keep_vars": true,
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"run_worker_first": true
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "PAYMENT_UPDATES",
				"class_name": "PaymentUpdates"
			}
		]
	},
	"exports": {
		"PaymentUpdates": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	}
}
